### JupyterNotebooks template
# gitignore template for Jupyter Notebooks
# website: http://jupyter.org/

.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IPython
profile_default/
ipython_config.py
sample.ipynb


### Python template
# IPython
profile_default/
ipython_config.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
.idea/


# RunPod credentials and CLI binary (repo-root only; do NOT match deploy/runpod/)
/runpod
/runpod.pub
/runpodctl

# Data and model weights (large, downloaded at runtime)
output/
data/
models/

# Build/tool artifacts
.playwright-mcp/
gen-lang-client-*.json

# Debug/development outputs
docs/conversation/
docs/reports/runpod_sections/
docs/outputs/

# Large images (keep smaller branding assets)
docs/Styling/wanderduck_office_coloured.png

# AI assistant configs (local only)
GEMINI.md
